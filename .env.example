# Copy to .env and fill in real values. Never commit the real .env file.
# Used by: root docker-compose.yml (local) and azure/deploy.sh (cloud) -
# same variable names, same meaning, in both places.

# ---- Backend ----
JWT_SECRET=change-this-to-a-long-random-string-at-least-256-bits
JWT_EXPIRATION_MINUTES=1440
HOLD_DURATION_MINUTES=5
HOLD_EXPIRY_SCAN_INTERVAL_MS=30000

# Razorpay TEST MODE keys only - https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set the same value when configuring the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Who's allowed to call the backend. Local default covers the Vite dev
# server (5173) and the dockerized frontend (8081); update for Azure - see
# azure/.env.example.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- Frontend ----
# Baked into the JS bundle at Docker BUILD time, not read at container start
# (see frontend/Dockerfile). Where the browser reaches the backend.
VITE_API_BASE_URL=http://localhost:8080

# ---- Azure (only read by azure/setup-infra.sh and azure/deploy.sh) ----
AZURE_RESOURCE_GROUP=seatsync-rg
AZURE_LOCATION=centralindia
AZURE_ACR_NAME=seatsyncacr
AZURE_DNS_LABEL=seatsync-app
