{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string"
    },
    "acrLoginServer": {
      "type": "string"
    },
    "acrUsername": {
      "type": "string"
    },
    "acrPassword": {
      "type": "securestring"
    },
    "backendImageTag": {
      "type": "string"
    },
    "frontendImageTag": {
      "type": "string"
    },
    "dnsLabel": {
      "type": "string"
    },
    "jwtSecret": {
      "type": "securestring"
    },
    "razorpayKeyId": {
      "type": "string"
    },
    "razorpayKeySecret": {
      "type": "securestring"
    },
    "razorpayWebhookSecret": {
      "type": "securestring"
    },
    "corsAllowedOrigins": {
      "type": "string"
    },
    "dbPassword": {
      "type": "securestring",
      "defaultValue": "seatsync"
    }
  },
  "resources": [
    {
      "type": "Microsoft.ContainerInstance/containerGroups",
      "apiVersion": "2023-05-01",
      "name": "seatsync-app",
      "location": "[parameters('location')]",
      "properties": {
        "osType": "Linux",
        "restartPolicy": "Always",
        "imageRegistryCredentials": [
          {
            "server": "[parameters('acrLoginServer')]",
            "username": "[parameters('acrUsername')]",
            "password": "[parameters('acrPassword')]"
          }
        ],
        "ipAddress": {
          "type": "Public",
          "dnsNameLabel": "[parameters('dnsLabel')]",
          "ports": [
            { "port": 8080, "protocol": "TCP" },
            { "port": 8081, "protocol": "TCP" }
          ]
        },
        "containers": [
          {
            "name": "postgres",
            "properties": {
              "image": "[format('{0}/postgres:16-alpine', parameters('acrLoginServer'))]",
              "ports": [
                { "port": 5432, "protocol": "TCP" }
              ],
              "environmentVariables": [
                { "name": "POSTGRES_DB", "value": "seatsync" },
                { "name": "POSTGRES_USER", "value": "seatsync" },
                { "name": "POSTGRES_PASSWORD", "secureValue": "[parameters('dbPassword')]" }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              }
            }
          },
          {
            "name": "backend",
            "properties": {
              "image": "[format('{0}/seatsync-backend:{1}', parameters('acrLoginServer'), parameters('backendImageTag'))]",
              "ports": [
                { "port": 8080, "protocol": "TCP" }
              ],
              "environmentVariables": [
                { "name": "DB_URL", "value": "jdbc:postgresql://localhost:5432/seatsync" },
                { "name": "DB_USERNAME", "value": "seatsync" },
                { "name": "DB_PASSWORD", "secureValue": "[parameters('dbPassword')]" },
                { "name": "JWT_SECRET", "secureValue": "[parameters('jwtSecret')]" },
                { "name": "CORS_ALLOWED_ORIGINS", "value": "[parameters('corsAllowedOrigins')]" },
                { "name": "RAZORPAY_KEY_ID", "value": "[parameters('razorpayKeyId')]" },
                { "name": "RAZORPAY_KEY_SECRET", "secureValue": "[parameters('razorpayKeySecret')]" },
                { "name": "RAZORPAY_WEBHOOK_SECRET", "secureValue": "[parameters('razorpayWebhookSecret')]" }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 2
                }
              }
            }
          },
          {
            "name": "frontend",
            "properties": {
              "image": "[format('{0}/seatsync-frontend:{1}', parameters('acrLoginServer'), parameters('frontendImageTag'))]",
              "ports": [
                { "port": 8081, "protocol": "TCP" }
              ],
              "resources": {
                "requests": {
                  "cpu": 1,
                  "memoryInGB": 1
                }
              }
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ContainerInstance/containerGroups', 'seatsync-app')).ipAddress.fqdn]"
    },
    "frontendUrl": {
      "type": "string",
      "value": "[format('http://{0}:8081', reference(resourceId('Microsoft.ContainerInstance/containerGroups', 'seatsync-app')).ipAddress.fqdn)]"
    },
    "backendUrl": {
      "type": "string",
      "value": "[format('http://{0}:8080', reference(resourceId('Microsoft.ContainerInstance/containerGroups', 'seatsync-app')).ipAddress.fqdn)]"
    }
  }
}
